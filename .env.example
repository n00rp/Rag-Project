# Kopiera till .env och fyll i. .env checkas ALDRIG in.
# Samma fil fungerar på laptop och stationär; skillnaderna är backends och OLLAMA_BASE_URL.

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=docassistant

# Embeddings: "sentence-transformers" (riktig modell, laddas ned första gången) eller "fake" (snabb, bara för utveckling/tester)
EMBEDDING_BACKEND=fake
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# LLM: "fake" (ekar första utdraget, ingen GPU behövs) eller "ollama" (riktiga svar)
LLM_BACKEND=fake
LLM_MODEL=
# Stationär (GPU): http://localhost:11434
# Laptop: peka mot stationären via Tailscale, t.ex. http://<stationar-namn>:11434
# Kör tjänsten i Docker och Ollama på värddatorn: använd värdens IP/Tailscale-namn, inte localhost.
OLLAMA_BASE_URL=http://localhost:11434

# Delad hemlighet mellan .NET-API:et och AI-tjänsten. Tom = ingen kontroll (bara OK lokalt).
INTERNAL_API_KEY=

JWT_SIGNING_KEY=generate-a-long-random-string-locally
