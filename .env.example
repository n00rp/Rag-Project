# Kopiera till .env och fyll i. .env checkas ALDRIG in.
# Samma fil fungerar på laptop och stationär; skillnaderna är backends och OLLAMA_BASE_URL.

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=docassistant

# Embeddings: "sentence-transformers" (riktig modell, laddas ned första gången) eller "fake" (snabb, bara för utveckling/tester)
EMBEDDING_BACKEND=fake
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
# Tröskel för "inget stöd" på bästa träffen. 0,82 för e5-base (0,83 för e5-small).
MIN_SCORE=0.82
# Byte av modell med annan dimension tömmer vektorerna: sätt true EN gång, indexera om (python scripts/reindex.py), sätt tillbaka.
RESET_VECTORS_ON_DIM_CHANGE=false
# Omrankare som omordnar de 30 bästa träffarna (+16 rätta svar på HR-frågorna, eval/README.md). Kräver GPU-torch för
# rimlig svarstid (ca 9 s på CPU, +0,7 s på RTX 5080), så den används när AI_SERVICE_HOST=windows. Tom = av.
RERANK_MODEL=
# "windows": ai-service körs som en Windows-process med den lokala venv:en och GPU:n (scripts/start.ps1 startar den), och
# API:et i Docker pekar dit. Tom: ai-service körs i Docker (CPU).
AI_SERVICE_HOST=
# Vardagsspråk: modellen skriver om frågan till dokumentens termer före sökningen (+0,5 s), en källa som nämns vid namn
# ("enligt LAS", "semesterlagen") får egna träffar, och uppföljningsfrågor görs fristående av de tre senaste frågorna.
# Mätt (eval/README.md): vardagsfrågor 25 -> 32 av 47 rätta, men formella frågor 66 -> 62 av 73. Slå på tillsammans med
# omrankaren. NAME_SOURCES gav samma summa med fler rörliga delar och är av.
REWRITE_QUERY=false
NAME_SOURCES=false

# LLM: "fake" (ekar första utdraget, ingen GPU behövs) eller "ollama" (riktiga svar)
LLM_BACKEND=fake
# Bäst i utvärderingen (eval/README.md): gemma3:12b. Ollama kör den med 4096 i kontext, vilket avbryter översiktssvar (12 utdrag).
# Skapa en variant med större kontext (ingen nedladdning): ollama create gemma3-12b-8k  med en Modelfile som har
#   FROM gemma3:12b  och  PARAMETER num_ctx 8192   och sätt LLM_MODEL=gemma3-12b-8k
LLM_MODEL=
# Stationär (GPU): http://localhost:11434
# Laptop: peka mot stationären via Tailscale, t.ex. http://<stationar-namn>:11434
# Kör tjänsten i Docker och Ollama på värddatorn: använd värdens IP/Tailscale-namn, inte localhost.
OLLAMA_BASE_URL=http://localhost:11434

# Delad hemlighet mellan .NET-API:et och AI-tjänsten. Tom = ingen kontroll (bara OK lokalt).
INTERNAL_API_KEY=

JWT_SIGNING_KEY=generate-a-long-random-string-locally
