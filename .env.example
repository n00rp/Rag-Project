# Kopiera till .env och fyll i. .env checkas ALDRIG in.
# Samma fil används på laptop och stationär; skillnaden är OLLAMA_BASE_URL.

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=docassistant

# Stationär (GPU): http://localhost:11434
# Laptop: peka mot stationärn via Tailscale, t.ex. http://<stationar-namn>:11434
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=
EMBEDDING_MODEL=intfloat/multilingual-e5-small

JWT_SIGNING_KEY=generate-a-long-random-string-locally
